{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Studio project provenance",
  "type": "object",
  "required": ["schema_version", "hyperframes_version", "frames"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["context_version", "kind", "unit_id", "effective_sha256"],
      "properties": {
        "context_version": {"enum": [1, 2]},
        "kind": {"const": "unit"},
        "unit_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "effective_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "scene_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^scene-[0-9]{2,}$"}
    },
    "hyperframes_version": {"type": "string", "minLength": 1},
    "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}}
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 2}}},
    "then": {
      "required": ["context", "scene_ids"],
      "properties": {"context": {"properties": {"kind": {"const": "unit"}}}}
    },
    "else": {"not": {"anyOf": [{"required": ["context"]}, {"required": ["scene_ids"]}]}}
  }],
  "$defs": {
    "frame": {
      "type": "object",
      "required": ["shot_id", "composition", "asset", "asset_sha256", "take", "manifest", "manifest_sha256"],
      "additionalProperties": false,
      "properties": {
        "shot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "composition": {"type": "string", "minLength": 1},
        "asset": {"type": "string", "minLength": 1},
        "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{12,64}$"},
        "take": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
