{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "productionContext": {
      "type": "object",
      "required": ["context_version", "kind", "effective_sha256"],
      "properties": {
        "context_version": {"type": "integer", "enum": [1, 2]},
        "kind": {"enum": ["production", "unit"]},
        "unit_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"},
        "effective_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}
      },
      "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"kind": {"const": "unit"}}, "required": ["kind"]},
        "then": {"required": ["unit_id"]},
        "else": {"not": {"required": ["unit_id"]}}
      }]
    },
    "requestV3": {
      "description": "Scoped request. Operational readers recompute context and use the normalized shared project digest; legacy hash algorithms remain unchanged.",
      "type": "object",
      "required": [
        "schema_version", "operation_id", "asset_id", "transport", "model",
        "operation", "prompt_file", "prompt_sha256", "request_sha256",
        "references", "params", "submission_status", "provider_task_id",
        "provider_status", "review_status", "cost", "approval_mode",
        "project_sha256", "context"
      ],
      "properties": {
        "schema_version": {"const": 3},
        "context": {"$ref": "#/$defs/productionContext"},
        "operation_id": {"$ref": "#/$defs/requestV2/properties/operation_id"},
        "asset_id": {"$ref": "#/$defs/requestV2/properties/asset_id"},
        "transport": {"$ref": "#/$defs/requestV2/properties/transport"},
        "model": {"$ref": "#/$defs/requestV2/properties/model"},
        "operation": {"$ref": "#/$defs/requestV2/properties/operation"},
        "prompt_file": {"$ref": "#/$defs/requestV2/properties/prompt_file"},
        "prompt_sha256": {"$ref": "#/$defs/requestV2/properties/prompt_sha256"},
        "request_sha256": {"$ref": "#/$defs/requestV2/properties/request_sha256"},
        "references": {"$ref": "#/$defs/requestV2/properties/references"},
        "params": {"$ref": "#/$defs/requestV2/properties/params"},
        "submission_status": {"$ref": "#/$defs/requestV2/properties/submission_status"},
        "provider_task_id": {"$ref": "#/$defs/requestV2/properties/provider_task_id"},
        "provider_status": {"$ref": "#/$defs/requestV2/properties/provider_status"},
        "review_status": {"$ref": "#/$defs/requestV2/properties/review_status"},
        "cost": {"$ref": "#/$defs/requestV2/properties/cost"},
        "extensions": {"$ref": "#/$defs/requestV2/properties/extensions"},
        "approval_mode": {"$ref": "#/$defs/requestV2/properties/approval_mode"},
        "project_sha256": {"$ref": "#/$defs/requestV2/properties/project_sha256"}
      },
      "additionalProperties": false,
      "allOf": [{"$ref": "#/$defs/requestV2/allOf/0"}]
    },
    "requestV1": {
      "type": "object",
      "required": [
        "schema_version",
        "operation_id",
        "asset_id",
        "transport",
        "model",
        "operation",
        "prompt_file",
        "prompt_sha256",
        "request_sha256",
        "references",
        "params",
        "submission_status",
        "provider_task_id",
        "provider_status",
        "review_status",
        "cost"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "ark-mcp",
            "arkcli",
            "curl"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "prompt_file": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "role",
              "binding",
              "approval_evidence"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "role": {
                "enum": [
                  "reference_image",
                  "first_frame",
                  "last_frame",
                  "reference_video",
                  "reference_audio"
                ]
              },
              "binding": {
                "type": "string",
                "pattern": "^@(Image|Video|Audio) [1-9][0-9]*$"
              },
              "approval_evidence": {
                "type": "object",
                "required": [
                  "manifest",
                  "field"
                ],
                "properties": {
                  "manifest": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "enum": [
                      "selected_variant",
                      "selected_variants"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "field": {
                          "const": "selected_variants"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "key"
                      ]
                    }
                  }
                ]
              },
              "control_only": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "params": {
          "type": "object"
        },
        "submission_status": {
          "enum": [
            "prepared",
            "submitting",
            "submission_unknown",
            "acknowledged",
            "terminal"
          ]
        },
        "provider_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "enum": [
            "not_started",
            "review",
            "approved",
            "rejected"
          ]
        },
        "cost": {
          "type": "object",
          "required": [
            "estimated",
            "confirmed",
            "currency"
          ],
          "properties": {
            "estimated": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "confirmed": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "usage": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "submission_status": {
                "const": "acknowledged"
              }
            }
          },
          "then": {
            "properties": {
              "provider_task_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "requestV2": {
      "type": "object",
      "required": [
        "schema_version",
        "operation_id",
        "asset_id",
        "transport",
        "model",
        "operation",
        "prompt_file",
        "prompt_sha256",
        "request_sha256",
        "references",
        "params",
        "submission_status",
        "provider_task_id",
        "provider_status",
        "review_status",
        "cost",
        "approval_mode",
        "project_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "ark-mcp",
            "arkcli",
            "curl"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "prompt_file": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "role",
              "binding",
              "approval_evidence"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "role": {
                "enum": [
                  "reference_image",
                  "first_frame",
                  "last_frame",
                  "reference_video",
                  "reference_audio"
                ]
              },
              "binding": {
                "type": "string",
                "pattern": "^@(Image|Video|Audio) [1-9][0-9]*$"
              },
              "approval_evidence": {
                "type": "object",
                "required": [
                  "manifest",
                  "field",
                  "selected_sha256"
                ],
                "properties": {
                  "manifest": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "enum": [
                      "selected_variant",
                      "selected_variants"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "decision_path": {
                    "type": "string",
                    "pattern": "^decisions/[A-Za-z0-9][A-Za-z0-9_-]*\\.json$"
                  },
                  "decision_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "review_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "selected_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "evidence_type": {
                    "const": "legacy"
                  },
                  "legacy_asset_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "audit_path": {
                    "const": "selection.log"
                  },
                  "audit_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "field": {
                          "const": "selected_variants"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "key"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "evidence_type": {
                          "const": "legacy"
                        }
                      },
                      "required": [
                        "evidence_type"
                      ]
                    },
                    "then": {
                      "required": [
                        "legacy_asset_id",
                        "audit_path",
                        "audit_sha256"
                      ]
                    },
                    "else": {
                      "required": [
                        "decision_id",
                        "decision_path",
                        "decision_sha256",
                        "review_path",
                        "review_sha256"
                      ]
                    }
                  }
                ]
              },
              "control_only": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "params": {
          "type": "object"
        },
        "submission_status": {
          "enum": [
            "prepared",
            "submitting",
            "submission_unknown",
            "acknowledged",
            "terminal"
          ]
        },
        "provider_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "enum": [
            "not_started",
            "review",
            "approved",
            "rejected"
          ]
        },
        "cost": {
          "type": "object",
          "required": [
            "estimated",
            "confirmed",
            "currency"
          ],
          "properties": {
            "estimated": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "confirmed": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "usage": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "type": "object"
        },
        "approval_mode": {
          "enum": [
            "approve_for_me",
            "ask_for_approval"
          ]
        },
        "project_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "submission_status": {
                "const": "acknowledged"
              }
            }
          },
          "then": {
            "properties": {
              "provider_task_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/requestV1"
    },
    {
      "$ref": "#/$defs/requestV2"
    },
    {
      "$ref": "#/$defs/requestV3"
    }
  ]
}
