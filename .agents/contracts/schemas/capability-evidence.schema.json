{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "source",
    "verified_at",
    "operations",
    "parameters",
    "reference_roles",
    "max_references"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "profile_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "transport": {"enum": ["ark-mcp", "arkcli", "curl"]},
    "tool_schema_revision": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "parameter_constraints": {
      "type": "array",
      "items": {"type": ["object", "boolean"]}
    },
    "modality_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/$defs/modality"},
        "video": {"$ref": "#/$defs/modality"},
        "audio": {"$ref": "#/$defs/modality"}
      }
    },
    "preview": {
      "type": "object",
      "required": ["native_draft", "promotion", "ordinary_preview"],
      "additionalProperties": false,
      "properties": {
        "native_draft": {"$ref": "#/$defs/support"},
        "promotion": {"$ref": "#/$defs/support"},
        "ordinary_preview": {"$ref": "#/$defs/support"}
      }
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "parameters": {
      "type": "object"
    },
    "required_parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_references": {
      "type": "integer",
      "minimum": 0
    },
    "supports_first_frame_with_reference_images": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
    "then": {
      "required": [
        "profile_id", "provider", "operation", "transport", "tool_schema_revision",
        "valid_from", "expires_at", "preview", "modality_limits", "parameter_constraints"
      ],
      "properties": {"operations": {"maxItems": 1}}
    }
  }],
  "$defs": {
    "support": {"enum": ["supported", "unsupported", "unknown"]},
    "modality": {
      "type": "object",
      "required": ["max_count"],
      "additionalProperties": false,
      "properties": {
        "max_count": {"type": "integer", "minimum": 0},
        "max_duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
