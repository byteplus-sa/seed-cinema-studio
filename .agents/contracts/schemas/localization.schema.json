{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seed:localization",
  "title": "Source-preserving localization record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit_id", "target_language", "route", "source_master", "source_inputs", "outputs", "lip_sync", "cultural_review"],
  "properties": {
    "schema_version": {"const": 1},
    "unit_id": {"$ref": "urn:seed:post-common#/$defs/id"},
    "target_language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})*$"},
    "route": {"enum": ["subtitles", "revoice", "regenerate"]},
    "source_master": {"$ref": "urn:seed:post-common#/$defs/asset"},
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:seed:post-common#/$defs/asset"},
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:seed:post-common#/$defs/asset"},
      "uniqueItems": true
    },
    "lip_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence"],
      "properties": {
        "verdict": {"enum": ["unverified", "not_applicable", "approximate", "native"]},
        "evidence": {"$ref": "urn:seed:post-common#/$defs/evidence"}
      }
    },
    "cultural_review": {"$ref": "urn:seed:post-common#/$defs/review"}
  }
}
